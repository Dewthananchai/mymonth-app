# ============================================
# MyMonth Environment Variables
# ============================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT Secret (เปลี่ยนเป็นค่าสุ่มยาวๆ ในการผลิต)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Google Login
VITE_GOOGLE_CLIENT_ID=

# ============================================
# LINE Integration
# ============================================
# วิธีตั้งค่า:
# 1. ไปที่ https://developers.line.biz/console/
# 2. สร้าง Provider ใหม่ (เช่น "MyMonth")
# 3. สร้าง Channel:

# LINE Login Channel (สำหรับเข้าสู่ระบบด้วย LINE)
LINE_CHANNEL_LOGIN_ID=
LINE_CHANNEL_LOGIN_SECRET=

# LINE Messaging API Channel (สำหรับ LINE Bot)
LINE_CHANNEL_MESSAGING_ID=
LINE_CHANNEL_MESSAGING_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Notify Token (สำหรับส่งการแจ้งเตือน)
# สร้างที่ https://notify-bot.line.me/
LINE_NOTIFY_TOKEN=

# Callback URL (เปลี่ยนเป็น domain จริงในการผลิต)
LINE_CALLBACK_URL=http://localhost:5000/api/line/callback
